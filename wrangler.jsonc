{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thakbo",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Plain (non-secret) configuration.
  "vars": {
    "APP_NAME": "THAKBO"
  },

  // Production D1 binding. This starter ZIP deliberately does not guess your account-specific ID.
  // Before deploying, create/identify thakbo-db in your Cloudflare account and set its real database_id here.
  // The guarded production migration workflow resolves the database by exact name, but it does not edit this file.
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thakbo-db",
      "migrations_dir": "db/migrations"
    }
  ],

  // Production R2 bucket for listing images. Create/verify thakbo-media in your Cloudflare account before deployment.
  // Worker-to-R2 access uses this binding only; no access keys are needed.
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "thakbo-media"
    }
  ],

  "previews": {
    "vars": {
      "APP_NAME": "thakbo-preview"
    },
    // Separate D1 database created for Preview. Keep this distinct from thakbo-db.
    "d1_databases": [
      {
        "binding": "DB",
        "database_name": "thakbo-preview",
        "database_id": "d6645494-9dfd-4916-9eec-a040b3404ef7",
        "migrations_dir": "db/migrations"
      }
    ],
    "r2_buckets": [
      {
        "binding": "MEDIA_BUCKET",
        "bucket_name": "thakbo-media-preview"
      }
    ]
  }

  // Secrets (never put them in this file):
  //   BETTER_AUTH_SECRET  -> `npx wrangler secret put BETTER_AUTH_SECRET`
  //   BETTER_AUTH_URL     -> optional, only if the auto-detected site URL is wrong
  //   RESEND_API_KEY      -> Resend transactional email API key (required for password reset)
  //   RESEND_FROM_EMAIL   -> optional verified sender, e.g. THAKBO <noreply@trustedtoolsweb.com>
}
