{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "thakbo",
  "main": "./workers/app.ts",
  "compatibility_date": "2026-08-18",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  // Plain (non-secret) configuration.
  "vars": {
    "APP_NAME": "THAKBO"
  },

  // D1 database. NO database_id is committed on purpose.
  // Wrangler creates the database automatically on first deploy, or you can
  // create it yourself and paste the id here (see README, "D1 setup").
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "thakbo-db",
      "migrations_dir": "db/migrations"
    }
  ],

  // R2 bucket for listing images. Created on first deploy or manually (see README, "R2 setup").
  // Worker-to-R2 access uses this binding only: no access keys are needed.
  "r2_buckets": [
    {
      "binding": "MEDIA_BUCKET",
      "bucket_name": "thakbo-media"
    }
  ]

  // Secrets (never put them in this file):
  //   BETTER_AUTH_SECRET  -> `npx wrangler secret put BETTER_AUTH_SECRET`
  //   BETTER_AUTH_URL     -> optional, only if the auto-detected site URL is wrong
}
