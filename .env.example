# THAKBO — local development variables
# Copy this file to `.dev.vars` (that exact name) for local development:
#     cp .env.example .dev.vars
# `.dev.vars` is ignored by Git. NEVER commit real values.
#
# Cloudflare Workers read local secrets from `.dev.vars`; production secrets are
# set with `npx wrangler secret put <NAME>` (see README).

# --- SERVER-ONLY SECRETS (never exposed to the browser) ---

# Long random string used by Better Auth to sign sessions. Minimum 32 characters.
# Generate one with:  openssl rand -base64 32
BETTER_AUTH_SECRET=

# --- SERVER-ONLY CONFIGURATION (optional) ---

# Public address of the site. Leave empty to let Better Auth detect it from the request.
# Local example: http://localhost:5173   Production example: your own https domain
BETTER_AUTH_URL=

# NOTE: D1 (DB) and R2 (MEDIA_BUCKET) are Worker BINDINGS configured in wrangler.jsonc.
# They need no keys or passwords, so they do not appear here.
# NOTE: THAKBO has no PUBLIC (browser-visible) variables in Milestone 1.
