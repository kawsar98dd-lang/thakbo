{
  "name": "thakbo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "THAKBO — location-first accommodation discovery marketplace for Bangladesh.",
  "engines": {
    "node": ">=22.22.0",
    "npm": ">=10.9.0"
  },
  "scripts": {
    "dev": "react-router dev",
    "build": "react-router build",
    "preview": "npm run build && vite preview",
    "deploy": "npm run build && wrangler deploy",
    "typegen": "wrangler types && react-router typegen",
    "typecheck": "npm run typegen && tsc --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:migrate:local": "wrangler d1 migrations apply thakbo-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply thakbo-db --remote",
    "db:seed:local": "wrangler d1 execute thakbo-db --local --file=db/seeds/0001_reference_data.sql",
    "db:seed:remote": "wrangler d1 execute thakbo-db --remote --file=db/seeds/0001_reference_data.sql"
  },
  "dependencies": {
    "better-auth": "^1.3.0",
    "isbot": "^5.1.0",
    "kysely": "^0.28.0",
    "kysely-d1": "^0.4.0",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-router": "8.4.0",
    "zod": "^4.0.0"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.62.3",
    "@eslint/js": "^9.0.0",
    "@react-router/dev": "8.4.0",
    "@tailwindcss/vite": "^4.2.2",
    "@types/node": "^22.0.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "eslint": "^9.0.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.0.0",
    "tailwindcss": "^4.2.2",
    "typescript": "^5.9.0",
    "typescript-eslint": "^8.0.0",
    "vite": "^8.0.0",
    "vitest": "^4.1.0",
    "wrangler": "^4.145.0"
  },
  "overrides": {
    "@vitejs/devtools-vitest": {
      "vitest": "^4.1.0"
    }
  }
}
